{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cic-cloud",
  "main": "src/worker.ts",
  "compatibility_date": "2024-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "cic-materials"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cic-cloud-db",
      "database_id": "ad40970a-b0cc-4ec1-8ef6-20c80726fb29"
    }
  ],
  "routes": [
    {
      "pattern": "cic-cloud.com",
      "custom_domain": true
    }
  ],
  "workers_dev": true
}
